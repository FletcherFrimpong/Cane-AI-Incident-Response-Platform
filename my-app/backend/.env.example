# Local backend (uvicorn on the host, Postgres/Redis via `docker compose up postgres redis -d`)
CANE_DATABASE_URL=postgresql+asyncpg://cane:cane_secret@localhost:5432/cane_db
CANE_REDIS_URL=redis://localhost:6379/0
CANE_CELERY_BROKER_URL=redis://localhost:6379/1
CANE_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Generate each with: openssl rand -hex 32
CANE_JWT_SECRET_KEY=
CANE_ENCRYPTION_MASTER_KEY=

# true = local development: allows default secrets and the mock AI provider
CANE_DEBUG=true

# Automated AI triage: claude | openai | azure_openai | mock (debug only)
CANE_AUTO_TRIAGE_PROVIDER=claude
CANE_AUTO_TRIAGE_API_KEY=

# Shared secret for machine log senders (X-API-Key header)
CANE_INGEST_API_KEY=
